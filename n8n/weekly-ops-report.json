{
  "id": "AgentWeeklyReport",
  "name": "Weekly operations report (AI data agent → email)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "03e45d79-8192-404f-be1a-f9384258dc7e",
      "name": "Every Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "6ad2d890-bfa9-4286-8ed0-ef23c8f04bcb",
      "name": "Manual run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_API_URL }}/ask",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AGENT_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: \"Prepare the weekly operations report for management. Cover: 1) SLA compliance for high/critical tickets last week vs the previous 4 weeks, 2) current backlog by team and anything older than 14 days, 3) the top 5 active customers at churn risk and why, 4) billable time not yet invoiced. Use short sections with a Markdown table each and end with 3 recommended actions.\" }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "2a6cfe05-1261-4f75-aab2-c217468c8920",
      "name": "Ask the data agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        100
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "notes": "The agent decides which saved queries / SQL to run. Timeout 5 min: a report takes several tool calls."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ebcda92c-8751-491f-81eb-b02a7d497903",
              "leftValue": "={{ $json.stop }}",
              "rightValue": "answered",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "00f63f78-088a-4825-9a9a-285722e7f28e",
      "name": "Answered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        100
      ]
    },
    {
      "parameters": {
        "mode": "markdownToHtml",
        "markdown": "={{ $json.answer }}",
        "destinationKey": "html",
        "options": {
          "tables": true
        }
      },
      "id": "1c057e1d-d70a-421a-a7e4-ce76d2957848",
      "name": "Markdown to HTML",
      "type": "n8n-nodes-base.markdown",
      "typeVersion": 1,
      "position": [
        740,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "data-agent@example.com",
        "toEmail": "={{ $env.REPORT_EMAIL_TO }}",
        "subject": "=📊 Weekly operations report · {{ $now.toFormat('dd/MM/yyyy') }}",
        "html": "=<div style=\"font-family:Arial,sans-serif;max-width:720px\">\n{{ $json.html }}\n<hr style=\"border:none;border-top:1px solid #ddd;margin-top:24px\">\n<p style=\"color:#888;font-size:12px\">Generated by the Agentic Data Assistant · {{ $('Ask the data agent').item.json.steps.length }} tool calls · {{ $('Ask the data agent').item.json.sql.length }} SQL queries · model {{ $('Ask the data agent').item.json.model }}</p>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "6c076696-36b1-496f-92bb-20f54c2b9d78",
      "name": "Email report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        980,
        0
      ],
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "data-agent@example.com",
        "toEmail": "={{ $env.REPORT_EMAIL_TO }}",
        "subject": "⚠️ Weekly report could not be generated",
        "emailFormat": "text",
        "text": "=The data agent stopped with status '{{ $json.stop }}'.\n\n{{ $json.answer }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "fbf90358-bc6c-4358-b255-6570bcd898ac",
      "name": "Email: report failed",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        740,
        220
      ],
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP"
        }
      }
    }
  ],
  "connections": {
    "Every Monday 08:00": {
      "main": [
        [
          {
            "node": "Ask the data agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual run": {
      "main": [
        [
          {
            "node": "Ask the data agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask the data agent": {
      "main": [
        [
          {
            "node": "Answered?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Answered?": {
      "main": [
        [
          {
            "node": "Markdown to HTML",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email: report failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Markdown to HTML": {
      "main": [
        [
          {
            "node": "Email report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
