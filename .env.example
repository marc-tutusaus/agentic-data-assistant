# ── LLM provider ────────────────────────────────────────────
# anthropic | openai | gemini | mistral | ollama | lmstudio
LLM_PROVIDER=gemini
# Leave empty for the provider default
# (claude-opus-5-5, gpt-5.6-luna, gemini-2.5-flash, mistral-large-latest, ...)
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Only for self-hosted OpenAI-compatible servers (Ollama, LM Studio, vLLM...)
LLM_BASE_URL=

# Claude only: effort level and server-side refusal fallback (default | off)
LLM_EFFORT=medium
ANTHROPIC_FALLBACKS=default

# ── Database ────────────────────────────────────────────────
# Docker: set the passwords below, docker-compose builds the URL.
POSTGRES_DB=analytics
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
AGENT_DB_PASSWORD=change-me-too
# Without Docker: run `data-agent dev-db` and paste the URL it prints.
AGENT_DATABASE_URL=

# ── Agent ───────────────────────────────────────────────────
AGENT_MAX_STEPS=12
SQL_MAX_ROWS=200
SQL_TIMEOUT_MS=5000

# ── API & n8n ───────────────────────────────────────────────
# Bearer token required by POST /ask (leave empty to disable auth locally)
API_TOKEN=
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me
GENERIC_TIMEZONE=Europe/Madrid
REPORT_EMAIL_TO=ops-team@example.com
# Only when running the agent outside docker-compose:
N8N_WEBHOOK_BASE_URL=
